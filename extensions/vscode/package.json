{
  "name": "cclint",
  "displayName": "cclint",
  "description": "Lint CLAUDE.md, AGENTS.md, and Claude Code config via cclint-lsp",
  "version": "0.23.0",
  "publisher": "felixgeelhaar",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d7377",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/felixgeelhaar/cclint.git",
    "directory": "extensions/vscode"
  },
  "bugs": {
    "url": "https://github.com/felixgeelhaar/cclint/issues"
  },
  "homepage": "https://github.com/felixgeelhaar/cclint/tree/main/extensions/vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "agents.md",
    "cclint",
    "lsp",
    "markdown"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/CLAUDE.md",
    "workspaceContains:**/AGENTS.md",
    "workspaceContains:**/.claude/**"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cclint.lint",
        "title": "cclint: Lint File / Workspace"
      },
      {
        "command": "cclint.fix",
        "title": "cclint: Fix Current File"
      },
      {
        "command": "cclint.init",
        "title": "cclint: Init CLAUDE.md"
      },
      {
        "command": "cclint.explain",
        "title": "cclint: Explain Violation at Cursor"
      }
    ],
    "configuration": {
      "title": "cclint",
      "properties": {
        "cclint.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the cclint-lsp binary. Empty = resolve from PATH / node_modules/.bin."
        },
        "cclint.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces communication between VS Code and cclint-lsp."
        }
      }
    },
    "languages": [
      {
        "id": "markdown",
        "extensions": [
          ".md",
          ".markdown"
        ],
        "filenames": [
          "CLAUDE.md",
          "AGENTS.md",
          "CLAUDE.local.md"
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.3"
  }
}
